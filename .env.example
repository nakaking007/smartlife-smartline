APP_TIMEZONE=Asia/Bangkok
PORT=3000

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/smartlife?retryWrites=true&w=majority

# LINE Messaging API
LINE_CHANNEL_SECRET=replace_with_line_channel_secret
LINE_CHANNEL_ACCESS_TOKEN=replace_with_line_channel_access_token
LINE_SKIP_SIGNATURE_VERIFY=false

# Public URL after deployment, for example:
# https://smartlife-smartline.onrender.com
PUBLIC_BASE_URL=https://your-production-domain.example.com

# Admin/API security
ADMIN_API_KEY=replace_with_strong_admin_key
ALERT_INGEST_API_KEY=replace_with_strong_alert_ingest_key

# Automation schedules
MORNING_BRIEF_CRON=0 6 * * *
BEDTIME_PROMPT_CRON=0 21 * * *
USGS_EARTHQUAKE_CRON=*/5 * * * *
ENABLE_USGS_EARTHQUAKE_ALERTS=true

# USGS earthquake feed
USGS_EARTHQUAKE_FEED=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/4.5_day.geojson
USGS_EARTHQUAKE_MIN_MAGNITUDE=4.5
USGS_EARTHQUAKE_MAX_AGE_MINUTES=180
