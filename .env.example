MONGODB_URI=mongodb://localhost:27017/smartlife
MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1
LINE_ACCESS_TOKEN=your_line_channel_access_token
LINE_USER_ID=your_line_user_id
WEATHER_API_KEY=your_openweather_api_key

# AI brain. Use auto fallback, or choose one/list: gemini,groq,openrouter,huggingface,ollama,none
AI_PROVIDER=auto
AI_FALLBACK_PROVIDERS=gemini,groq,openrouter,huggingface,pollinations
AI_MAX_HISTORY=12

# Gemini text/chat/translation
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Groq text/chat/translation
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.1-8b-instant

# OpenRouter free models router
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=openrouter/free

# Hugging Face Inference Providers
HF_TOKEN=your_huggingface_token
HF_MODEL=deepseek-ai/DeepSeek-V3-0324
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-dev

# Pollinations text and image. Get a free key at https://enter.pollinations.ai
POLLINATIONS_API_KEY=your_pollinations_api_key
POLLINATIONS_TEXT_MODEL=openai
POLLINATIONS_IMAGE_MODEL=flux

# Ollama local text/chat/translation. Add ollama to AI_FALLBACK_PROVIDERS only when it is running.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Optional image generation. LINE image messages need a public HTTPS base URL.
IMAGE_PROVIDER=auto
IMAGE_FALLBACK_PROVIDERS=openai,huggingface,pollinations
OPENAI_API_KEY=your_openai_api_key
OPENAI_IMAGE_MODEL=gpt-image-1-mini
PUBLIC_BASE_URL=https://your-public-domain.example.com
LIFF_ID=your_liff_id

# Optional payment instructions shown in LINE /สมัคร and /ปลดลอค
PAYMENT_PROMPTPAY=your_promptpay_phone_or_id
PAYMENT_BANK_ACCOUNT=ธนาคาร ตัวอย่าง 000-0-00000-0 ชื่อบัญชี SmartLife
PAYMENT_QR_URL=https://your-public-domain.example.com/payment-qr.png
PAYMENT_INSTRUCTIONS=โอนแล้วกรอกเลขอ้างอิง/แนบหลักฐานในหมายเหตุสมัครสมาชิก
